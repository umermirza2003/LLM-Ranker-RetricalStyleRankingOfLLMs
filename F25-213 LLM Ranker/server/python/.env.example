# Copy to .env (gitignored). Create a token: https://huggingface.co/settings/tokens
# Used by ranking_service.py and rank_transformers_service.py when downloading models.
# Never commit real tokens to git.
#
# HF_TOKEN=hf_your_token_here
# Optional alias (same effect):
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here
