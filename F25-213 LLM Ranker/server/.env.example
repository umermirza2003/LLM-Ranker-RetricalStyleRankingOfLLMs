# REQUEST_BODY_TYPE: generic | gemini | openai_chat | chat_completions

PORT=

# SQLite: stores query, llm_id (panel slot), llm_name, response (default server/data/responses.db)
# SQLITE_DB_PATH=

# Transformers CrossEncoder ranker (reads SQLite by batch_id). Start: python server/python/rank_transformers_service.py
RANK_TRANSFORMERS_SERVICE_URL=http://127.0.0.1:5056
RANK_TRANSFORMERS_TIMEOUT_MS=180000
# Optional ms to wait after saving rows before Python reads SQLite (helps on Windows). Default 250 when unset.
# RANK_TRANSFORMERS_DELAY_MS=250

# Dataset Train / CrossEncoder JSON scorer — must match ranking_service.py (default port 5055).
# Start: cd server/python && python ranking_service.py   (also launched by scripts/start-project.ps1)
# RANKING_SERVICE_URL=http://127.0.0.1:5055
# Hugging Face Hub token (for Python services only): set HF_TOKEN in server/python/.env — see server/python/.env.example
# Weight on CrossEncoder vs SQLite-derived model statistics when training on uploaded datasets (0–1). Default 0.35.
# TRAIN_SYSTEM_BLEND=0.35

